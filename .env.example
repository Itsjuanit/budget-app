# Configuración de Firebase (Consola de Firebase → Configuración del proyecto → Tus apps)
# Estos valores se embeben en el bundle del navegador: no son secretos.
# La seguridad real la dan las reglas de Firestore, no ocultar estas claves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional — sin este valor no se inicializa Analytics.
VITE_FIREBASE_MEASUREMENT_ID=
